# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Databricks PAT, warehouse ID, Genie agent ID. Commit .env.example instead.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
config.local.*

# Databricks CLI profile — contains tokens
.databrickscfg


# ---------------------------------------------------------------------------
# Spatial source data
# ---------------------------------------------------------------------------
# Never commit these. FIRE_HISTORY_SCAR alone is 248 MB, and all three layers are
# freely available from DEECA DataShare. Link to the source in the README.

# Shapefile and its siblings
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.qix
*.qpj
*.shp.xml

# Other spatial formats
*.gdb/
*.gpkg
*.geojson
*.kml
*.kmz
*.mif
*.mid
*.tab
*.dat
*.map
*.id

# Rasters
*.tif
*.tiff
*.img
*.asc

# Archives from DataShare
*.zip
*.7z
*.tar.gz

# Local working directories
data/
raw/
downloads/
extracted/


# ---------------------------------------------------------------------------
# Derived data
# ---------------------------------------------------------------------------
# Everything here is reproducible by re-running the notebooks.
*.parquet
*.orc
*.avro
_delta_log/
*.db
*.sqlite
*.sqlite3

# CSV is ignored by default, but keep small reference lookups if you add any
# (e.g. AUTH_ORG_C code to distributor name). Force-add with: git add -f
*.csv
!genie/**/*.csv
!docs/**/*.csv


# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing and linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/


# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
# Notebooks are committed as Databricks source .py files, not .ipynb. Exported
# .ipynb carries output cells that can include data and blow up diffs.
.ipynb_checkpoints/
*-checkpoint.ipynb
*.ipynb

# Databricks Git folder metadata
.databricks/


# ---------------------------------------------------------------------------
# Streamlit app (Phase 4-5)
# ---------------------------------------------------------------------------
.streamlit/secrets.toml
app/.streamlit/secrets.toml


# ---------------------------------------------------------------------------
# Submission artefacts
# ---------------------------------------------------------------------------
# Demo video and screen recordings. Too large for git, and they belong on
# YouTube or wherever the submission form points.
*.mp4
*.mov
*.avi
*.mkv
*.webm
recordings/


# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/


# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
