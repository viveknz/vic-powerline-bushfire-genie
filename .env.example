# Copy to .env and fill in. .env is gitignored.
#
# Get these from your Databricks workspace:
#   HOST      SQL Warehouses > your warehouse > Connection details
#   WAREHOUSE SQL Warehouses > your warehouse > URL, trailing 16 hex chars
#   GENIE     Genie Agents > your agent > URL
#   TOKEN     Settings > Developer > Access tokens

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-replace-me
DATABRICKS_WAREHOUSE_ID=0123456789abcdef
DATABRICKS_GENIE_SPACE_ID=replace-me

# Unity Catalog target
UC_CATALOG=workspace
UC_SCHEMA=bushfire
